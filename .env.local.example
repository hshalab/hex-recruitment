# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_STANDARD=price_...
STRIPE_PRICE_ID_PROFESSIONAL=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Anthropic (AI job ad assistant) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Firecrawl (company profile auto-fill) ────────────────────────────────────
FIRECRAWL_API_KEY=fc-...

# ── Google Calendar OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://hexrecruitment.co.uk
NEXT_PUBLIC_SITE_URL=https://hexrecruitment.co.uk

# ── Optional: UK address lookup ───────────────────────────────────────────────
# Free tier at ideal-postcodes.co.uk (50 lookups). Without this, falls back
# to area-level data only.
IDEAL_POSTCODES_KEY=your-ideal-postcodes-api-key

# ── Cron jobs ─────────────────────────────────────────────────────────────────
# Required for Vercel cron job authentication. Generate a random string
# and add it to Vercel environment variables.
CRON_SECRET=your-random-cron-secret

# ── Dev mode (never set true in production) ───────────────────────────────────
# NEXT_PUBLIC_DEV_MODE=true
