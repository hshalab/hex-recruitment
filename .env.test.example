# E2E test credentials — copy to .env.test and fill in real values
# NEVER commit .env.test — it's in .gitignore

BASE_URL=https://hex-recruitment.vercel.app

# Employer test account (must have at least 1 job posted + 1 interview scheduled)
EMPLOYER_EMAIL=your-employer@example.com
EMPLOYER_PASS=YourPassword123

# Candidate test account
CANDIDATE_EMAIL=your-candidate@example.com
CANDIDATE_PASS=YourPassword123
